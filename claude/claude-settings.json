{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"'\"'$CLAUDE_NOTIFICATION'\"'\" with title \"Claude\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
